{
  "name": "nimcode",
  "displayName": "NimCode",
  "publisher": "Batunash",
  "description": "NimCode VS Code Extension",
  "version": "0.1.17",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nimcode-sidebar",
          "title": "NimCode",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "nimcode-sidebar": [
        {
          "id": "nimcode.sessionsView",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "nimcode.newChat",
        "title": "NimCode: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "nimcode.openSession",
        "title": "NimCode: Open Session"
      },
      {
        "command": "nimcode.deleteSession",
        "title": "NimCode: Delete Session",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nimcode.newChat",
          "when": "view == nimcode.sessionsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "nimcode.deleteSession",
          "when": "view == nimcode.sessionsView",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "jest --coverage src/"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.1.3",
    "vsce": "^2.15.0"
  }
}
